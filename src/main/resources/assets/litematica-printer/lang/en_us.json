    "litematica-printer.config.printer.comment.clearFluid": "Whether to clear water/lava source blocks when the schematic target is fluid.\nRequires Break Blocks to automatically remove the fill block after placement.",
    "litematica-printer.config.printer.comment.blocksClearFluid": "Block ids to use for clearing fluid sources.",
    "litematica-printer.config.printer.comment.stripLogs": "Whether or not the printer should use normal logs if stripped\nversions are not available and then strip them with an axe.",
    "litematica-printer.config.printer.comment.interactBlocks": "Whether or not the printer should set block states.",
    "litematica-printer.config.printer.comment.breakBlocks": "Whether or not the printer should automatically break blocks that need to be removed.\nThe printer will select the best tool from your hotbar to break blocks efficiently.",
    "litematica-printer.config.printer.comment.breakerOption": "Control when Breaker is allowed to break blocks.",
    "litematica-printer.config.printer.comment.breakPreference": "Prefer Fortune or Silk Touch when selecting a breaker tool. Default ignores enchantments.",
    "litematica-printer.config.printer.comment.toolDurabilityProtection": "Skip tools whose remaining durability is at or below the threshold when the Breaker selects a tool.",
    "litematica-printer.config.printer.comment.toolDurabilityThreshold": "Tools with remaining durability at or below this value will not be selected by the Breaker.",
    "litematica-printer.config.printer.comment.breakListMode": "Controls how the break list restricts which blocks can be broken.\nNone: no restriction (only the built-in default ignore list applies).\nBlacklist: blocks in the list will not be broken.\nWhitelist: only blocks in the list will be broken.",
    "litematica-printer.config.printer.comment.breakBlocksBlacklist": "Blocks that will not be broken when the break list mode is set to blacklist.",
    "litematica-printer.config.printer.comment.breakBlocksWhitelist": "Only these blocks will be broken when the break list mode is set to whitelist.",
    "litematica-printer.config.printer.comment.avoidBreakingUnderPlayer": "When enabled, the Breaker will never break the block directly beneath the player, to avoid falling.",
    "litematica-printer.config.printer.comment.breakerUseBedrockMiner": "Allow Breaker to use BedrockMiner when the mod is installed.",
    "litematica-printer.config.printer.comment.printInAir": "Allow blocks to be placed in mid-air without requiring support blocks underneath.",
    "litematica-printer.config.printer.comment.fallingBlockPrintInAir": "Allow falling blocks (like sand, gravel, etc.) to be placed in mid-air even without support underneath.",
    "litematica-printer.config.printer.comment.printerCacheMs": "Cache time in milliseconds to avoid processing the same position repeatedly. Higher values reduce redundant operations.",
    "litematica-printer.config.printer.comment.rotate": "Alter the players yaw and pitch when placing blocks.",
    "litematica-printer.config.printer.comment.printerOnHudEnabled": "Whether to show the PrinterOn HUD text on screen.",
    "litematica-printer.config.printer.comment.printerOnHudX": "X position (pixels) of the top-left corner of the PrinterOn HUD text.",
    "litematica-printer.config.printer.comment.printerOnHudY": "Y position (pixels) of the top-left corner of the PrinterOn HUD text.",
    "litematica-printer.config.printer.comment.printerOnHudColor": "Color of the PrinterOn HUD text.",
    "litematica-printer.config.printer.comment.printerOnHudScale": "Font scale of the PrinterOn HUD text.",
    "litematica-printer.config.printer.comment.smartRedstoneEnabled": "Enable smart redstone placement to avoid QC (Quasi-Connectivity), BUD, and observer update order issues.\nPistons and observers will be placed in the correct order to prevent unintended activations.",
    "litematica-printer.config.printer.comment.observerAvoidAll": "Observers will avoid placement when facing blocks with incorrect states.\nThis prevents observers from triggering during placement but may cause deadlocks in some cases.",
    "litematica-printer.config.printer.comment.suppressPushLimitPistons": "Pistons that would exceed push limit when directly powered won't be placed.\nThis ensures pistons respect the 12-block push limit in redstone contraptions.",
